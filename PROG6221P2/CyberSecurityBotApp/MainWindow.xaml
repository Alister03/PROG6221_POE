<Window x:Class="CyberSecurityBotApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot" Height="660" Width="840"
        WindowStartupLocation="CenterScreen"
        Background="#1B1B2F" FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with Exit button -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" x:Name="ExitButton" Content="Exit"
                    Click="ExitButton_Click" Padding="16,6" Cursor="Hand"
                    Background="#2A2A45" Foreground="#EAEAF2" BorderThickness="0"/>
            <StackPanel>
                <TextBlock Text="🛡 Cybersecurity Awareness Bot" FontSize="22"
                           FontWeight="Bold" Foreground="#4EC9B0"/>
                <TextBlock FontSize="12" Foreground="#8888AA"
                           Text="Learn to stay safe online — ask me about passwords, phishing, scams &amp; privacy"/>
            </StackPanel>
        </DockPanel>

        <!-- ASCII art title screen (translated from Part 1) -->
        <Border Grid.Row="1" Background="#101021" CornerRadius="6" Padding="10"
                Margin="0,0,0,10" HorizontalAlignment="Left">
            <TextBlock x:Name="AsciiBlock" FontFamily="Consolas" FontSize="11"
                       Foreground="#C586C0" LineHeight="14"/>
        </Border>

        <!-- Chat log -->
        <ListBox x:Name="ChatList" Grid.Row="2" Background="#101021"
                 BorderBrush="#2A2A45" BorderThickness="1" Padding="8"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Padding" Value="4,2"/>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <!-- Input row -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InputBox" Grid.Column="0" FontSize="14" Padding="10,8"
                     Background="#25253D" Foreground="#EAEAF2" BorderBrush="#3A3A5A"
                     VerticalContentAlignment="Center" KeyDown="InputBox_KeyDown"/>
            <Button x:Name="SendButton" Grid.Column="1" Content="Send" Margin="8,0,0,0"
                    Padding="22,8" FontSize="14" FontWeight="SemiBold" Cursor="Hand"
                    Background="#4EC9B0" Foreground="#0B0B15" BorderThickness="0"
                    Click="SendButton_Click"/>
        </Grid>
    </Grid>
</Window>
